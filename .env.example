# Public application URL used in WhatsApp action links
NEXT_PUBLIC_SITE_URL=https://sayyir.sa

# GREEN API instance credentials (server-side only)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com

# Secret used as GREEN API "Webhook URL Token"
# Webhook URL: https://sayyir.sa/api/webhooks/green-api
GREEN_API_WEBHOOK_TOKEN=

# Optional dedicated secret for internal notification routes.
# If omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
INTERNAL_NOTIFICATION_SECRET=

# Current Sayyir admin WhatsApp number
ADMIN_PHONE=+966508424401
